# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The public address of the site, used in sign-up and password emails.
# Optional on Vercel (it uses the project's production address); set it
# when you add your own domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where members can reach the moderators (shown on About, Privacy and Banned pages)
NEXT_PUBLIC_CONTACT_EMAIL=moderators@example.com
# Cloudflare Turnstile site key. Set this ONLY after turning on CAPTCHA in
# Supabase (Authentication > Attack Protection) with the matching secret key.
# Leave empty to show no CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
